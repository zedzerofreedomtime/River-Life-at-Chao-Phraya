POSTGRES_PASSWORD=local-development-only
ADMIN_PASSWORD=replace-with-a-long-random-password
UPLOAD_DIR=/data/uploads
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3000
# Google Cloud OAuth Web client. Leave blank for local OTP-only development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Stripe sandbox: put the rotated sk_test_ key and optional whsec_ signing secret
# in the ignored .env.stripe.local file. See docs/stripe-sandbox.md.
