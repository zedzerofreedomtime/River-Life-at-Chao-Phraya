POSTGRES_PASSWORD=local-development-only
ADMIN_PASSWORD=replace-with-a-long-random-password
UPLOAD_DIR=/data/uploads
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3000
# Email OTP (credentials belong only in the ignored .env file).
# Use port 587/starttls or port 465/tls as specified by your provider.
OTP_DELIVERY_MODE=smtp
# Booking emails are independent of OTP. Use disabled to pause delivery.
BOOKING_EMAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Google Cloud OAuth Web client. Leave blank for local OTP-only development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Stripe sandbox: put the rotated sk_test_ key and optional whsec_ signing secret
# in the ignored .env.stripe.local file. See docs/stripe-sandbox.md.
