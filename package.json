{
  "name": "river-life",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "test:smoke": "playwright test tests/api.spec.ts --workers=1",
    "format:check": "prettier --check \"apps/web/src/**/*.{ts,tsx,css}\" \"tests/*.ts\""
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.6"
  }
}
